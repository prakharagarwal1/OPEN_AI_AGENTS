# Voice Agents Environment Configuration

# Server
PORT=3002
NODE_ENV=development
HOST=0.0.0.0

# OpenAI / LLM
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-realtime-preview
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepGram (Speech-to-Text)
DEEPGRAM_API_KEY=your-deepgram-api-key-here
DEEPGRAM_MODEL=deepgram nova-2
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_ENCODING=linear16
DEEPGRAM_SAMPLE_RATE=16000

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=21m004T2pkTYMVuFMvJy7K
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OPTIMIZE_FOR_LATENCY=0

# Redis (conversation state)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Voice Processing
VOICE_SAMPLE_RATE=16000
VOICE_CHANNELS=1
VOICE_BITS_PER_SAMPLE=16
VOICE_SILENCE_THRESHOLD=500
VOICE_SILENCE_DURATION=1000
VOICE_MAX_CHUNK_SIZE=4096

# VAD (Voice Activity Detection)
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE=500
VAD_MIN_SPEECH=250

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Auth
JWT_SECRET=change-this-jwt-secret-in-production
API_KEY=change-this-api-key-in-production

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000